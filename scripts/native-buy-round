#!/bin/sh
set -eu

cd -- "$(dirname -- "$0")/.."
for dependency in Xvfb xvfb-run xauth xdotool; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        printf 'Native Buy Round requires %s.\n' "$dependency" >&2
        exit 1
    fi
done

script=scripts/native_buy_round.py
screen=1440x900x24
if [ "${1-}" = --game-two ]; then
    shift
    script=scripts/native_game_two.py
    screen=4096x2304x24
elif [ "${1-}" = --signing ]; then
    shift
    script=scripts/native_signing.py
    screen=3840x2160x24
elif [ "${1-}" = --market ]; then
    shift
    script=scripts/native_market.py
    screen=3840x2160x24
elif [ "${1-}" = --start-game ]; then
    shift
    script=scripts/native_game_start.py
    screen=3840x2160x24
elif [ "${1-}" = --order ]; then
    shift
    script=scripts/native_purchase_order.py
    screen=4096x2304x24
fi

timeout 10m xvfb-run -a -e /dev/stderr -s "-screen 0 $screen -dpi 96" \
    python3 -B "$script" "$@"
