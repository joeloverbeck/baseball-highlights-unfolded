#!/bin/sh
set -eu

cd -- "$(dirname -- "$0")/.."
for dependency in Xvfb xvfb-run xauth xdotool; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
        printf 'Native stadium verification requires %s.\n' "$dependency" >&2
        exit 1
    fi
done

timeout 10m xvfb-run -a -e /dev/stderr -s '-screen 0 3840x2160x24 -dpi 96' \
    python3 -B scripts/native_stadium.py "$@"
